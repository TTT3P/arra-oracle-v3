# Oracle v2 Environment Variables
# Copy to .env and fill in values

# Server
PORT=47778
ORACLE_SESSION_SECRET=           # Random string for session signing (auto-generated if empty)
CORS_ORIGIN=                     # Allowed CORS origin for production (e.g., https://yourdomain.com)

# Database
ORACLE_DATA_DIR=                 # Path to Oracle data directory (default: ~/.oracle)

# Vector Store (choose one)
CHROMA_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings
OPENAI_API_KEY=                  # For OpenAI embeddings
OLLAMA_BASE_URL=http://localhost:11434  # For local Ollama embeddings

# Cloudflare (optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ORACLE_EMBEDDING_MODEL=

# Forum (optional)
ORACLE_FORUM_REPO=               # GitHub repo for forum sync (e.g., owner/repo)

# Source mappings (optional JSON)
ORACLE_SOURCE_MAPPINGS=          # e.g., {"key":"github.com/owner/repo"}

# --- HTTP idle timeout + search budget (OM-BL-2026-09-09-01) ---
# Bun closes a connection idle for this many seconds (Bun default 10 s, max 255). A synchronous FTS5
# scan can exceed 10 s, so keep this at the maximum unless you have a reason not to.
# ORACLE_HTTP_IDLE_TIMEOUT_S=255
# Per-search wall-clock budget: when the FTS leg already spent it, the vector leg is skipped and the
# response carries partial:true (FTS-only) instead of adding a proxy round-trip.
# ORACLE_SEARCH_BUDGET_MS=20000
# Admission gate: more searches in flight than this get 503 + Retry-After immediately instead of queueing.
# ORACLE_SEARCH_MAX_INFLIGHT=4
